# ---------------------------------------------------------------------------
# LayerOne Demo Console configuration
# Copy to .env and fill in. Real environment variables take precedence.
# ---------------------------------------------------------------------------

# "live" sends requests to your LayerOne gateway; "mock" uses the built-in
# simulated gateway (clearly labeled SIMULATED in the UI). Defaults to "live"
# when LAYERONE_BASE_URL is set, otherwise "mock".
LAYERONE_MODE=live

# Base URL of your LayerOne gateway (from your Booz Allen preview onboarding).
LAYERONE_BASE_URL=https://layerone.example.internal

# Path of the chat endpoint on the gateway. LayerOne fronts your existing
# model providers, so this is usually the OpenAI-compatible route.
LAYERONE_CHAT_PATH=/v1/chat/completions

# Credentials. The key is only ever sent server-side and is masked in traces.
LAYERONE_API_KEY=
LAYERONE_AUTH_HEADER=Authorization
# Prefix put in front of the key. Set to empty (LAYERONE_AUTH_SCHEME=) to send the raw key,
# e.g. with LAYERONE_AUTH_HEADER=x-api-key.
LAYERONE_AUTH_SCHEME=Bearer

# Model / route name LayerOne should use for the upstream provider.
LAYERONE_MODEL=gpt-4o

# Optional extra headers as JSON, e.g. agent identity or policy-set selectors.
# LAYERONE_EXTRA_HEADERS={"X-Agent-Id":"demo-agent","X-Policy-Set":"default"}

LAYERONE_TIMEOUT_MS=60000

# System prompt the demo "agent" sends with every request.
DEMO_SYSTEM_PROMPT=You are a helpful mission-support assistant.

# Web server. Use HOST=0.0.0.0 to show the console from another machine.
PORT=3000
HOST=127.0.0.1
